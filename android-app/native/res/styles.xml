<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#2a1a52</item>
        <item name="colorPrimaryDark">#0d1224</item>
        <item name="colorAccent">#8b6be0</item>
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">#0d1224</item>
        <item name="android:navigationBarColor">#0d1224</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@drawable/splash_bg</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#10224f</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:background">@drawable/splash_bg</item>
        <item name="android:statusBarColor">#0d1224</item>
        <item name="android:navigationBarColor">#0d1224</item>
    </style>
</resources>
